env = MOZ_ENABLE_WAYLAND,1

# Force Intel iGPU first & Firefox native Wayland
env = AQ_DRM_DEVICES,/dev/dri/card1:/dev/dri/card0
env = MOZ_ENABLE_WAYLAND,1

decoration {
    blur {
        enabled = true
        size = 4
        passes = 1
    }
    shadow {
        enabled = false
    }
}

misc {
    vfr = true
}

# --- iGPU Performance Overrides ---
env = MOZ_ENABLE_WAYLAND,1
env = ELECTRON_OZONE_PLATFORM_HINT,auto

misc {
    vfr = true
}

decoration {
    blur {
        enabled = true
        size = 4
        passes = 1
        new_optimizations = true
    }
    shadow {
        enabled = false
    }
}

# --- Snappy Workspace Switch Fix ---
decoration {
    blur {
        xray = true
    }
}

animations {
    enabled = true
    bezier = snappy, 0.15, 0.9, 0.1, 1.0
    animation = workspaces, 1, 2.5, snappy, slide
    animation = windows, 1, 2.5, snappy, popin 90%
}

windowrulev2 = noblur, class:^(firefox)$
windowrulev2 = noblur, class:^(org\.kde\.plasma-systemmonitor|gnome-system-monitor|missioncenter)$
monitor = eDP-1, 2160x1440@60, 0x0, 1.25

# --- Nvidia Primary GPU Configuration ---
env = AQ_DRM_DEVICES,/dev/dri/nvidia-card:/dev/dri/intel-card
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = GBM_BACKEND,nvidia-drm

# --- Clipboard-Only Region Screenshot ---
bind = SUPER SHIFT, S, exec, grim -g "$(slurp)" - | wl-copy

# --- Force Dark Mode Across GTK, Qt & XDG Portals ---
env = GTK_THEME,adw-gtk3-dark
env = QT_QPA_PLATFORMTHEME,qt6ct
